# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# ローカルは直接接続(db.<ref>.supabase.co:5432)でよいが、
# Vercel 等のサーバーレスでは必ず Connection Pooler の URL を使う
# (aws-*.pooler.supabase.com:6543 / Transaction mode)。
# 直接接続はIPv6のみ・接続数が少なく、本番で接続エラーになる。
DATABASE_URL=your_supabase_database_url

# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Claude API (optional — enables Claude provider in settings)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Books API
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Vercel Cron (本番のみ)
# Supabase 無料プランの自動停止を防ぐ keep-alive エンドポイントの認証に使う。
# ローカルでは不要。Vercel の環境変数に設定する。
CRON_SECRET=your_cron_secret
